# Database
DATABASE_URL="postgresql://user:password@localhost:5432/alpha_notebook?schema=public"

# Google OAuth (for NextAuth)
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# NextAuth / Auth.js
AUTH_SECRET="your-auth-secret"
NEXTAUTH_URL="http://localhost:3000"

# Exa API (content extraction)
EXA_API_KEY="your-exa-api-key"

# Google Gemini API (collection + source chat). Required in all environments,
# including Vercel production.
GOOGLE_AI_API_KEY="your-gemini-api-key"
