generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [vector]
}

model User {
  id            String       @id @default(cuid())
  email         String       @unique
  emailVerified DateTime?
  name          String?
  image         String?
  createdAt     DateTime     @default(now())
  accounts      Account[]
  sessions      Session[]
  collections   Collection[]
  conversations Conversation[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Collection {
  id             String   @id @default(cuid())
  userId         String
  name           String
  description    String?
  createdAt      DateTime @default(now())
  lastActivityAt DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sources        Source[]
}

model Source {
  id            String          @id @default(cuid())
  collectionId  String
  sourceType    SourceType      @default(URL)
  url           String?
  fileName      String?
  pdfData       Bytes?
  title         String?
  author        String?
  siteName      String?
  tags          String[]
  content       String?
  publishedAt   DateTime?
  status        SourceStatus    @default(PENDING)
  indexStatus   IndexStatus     @default(PENDING)
  createdAt     DateTime        @default(now())
  collection    Collection      @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  chunks        SourceChunk[]
  conversations Conversation[]
}

/// One indexed chunk of a source's markdown content.
/// Embedding column is added via raw SQL migration (Prisma has no native vector type).
model SourceChunk {
  id          String                       @id @default(cuid())
  sourceId    String
  ord         Int
  headingPath String?
  text        String
  charStart   Int
  charEnd     Int
  tokenCount  Int?
  embedding   Unsupported("vector(1536)")?
  textSearch  Unsupported("tsvector")?
  createdAt   DateTime                     @default(now())
  source      Source                       @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@unique([sourceId, ord])
  @@index([sourceId])
}

model Conversation {
  id        String    @id @default(cuid())
  sourceId  String
  userId    String
  title     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  source    Source    @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  Message[]

  @@index([sourceId, userId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  role           MessageRole
  content        String
  citations      Json?
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

/// Per-LLM-call telemetry. Written after each streamed chat completes.
/// Used for cost/perf analysis and provider A/B comparisons.
model LlmCall {
  id                  String    @id @default(cuid())
  userId              String?
  sourceId            String?
  conversationId      String?
  messageId           String?
  provider            String
  model               String
  /// Total tokens in the prompt (system + history + user).
  inputTokens         Int?
  /// Tokens served from cache (Gemini implicit/explicit caching).
  cachedInputTokens   Int?
  /// Generated reply tokens (excludes thinking).
  outputTokens        Int?
  /// Gemini "thinking" tokens (charged against output budget).
  thinkingTokens      Int?
  /// Wall-clock from request start to final token.
  latencyMs           Int?
  /// Time to first streamed token (responsiveness).
  ttftMs              Int?
  /// "completed" | "aborted" | "error"
  status              String    @default("completed")
  errorMessage        String?
  createdAt           DateTime  @default(now())

  @@index([createdAt])
  @@index([sourceId])
  @@index([userId])
}

enum IndexStatus {
  PENDING
  INDEXING
  READY
  FAILED
}

enum MessageRole {
  USER
  ASSISTANT
}

enum SourceType {
  URL
  PDF
}

enum SourceStatus {
  PENDING
  READY
  FAILED
}
